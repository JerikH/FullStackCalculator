# Disabled: GitHub runs only .yml/.yaml workflow files. To enable it, rename it:
#   git mv .github/workflows/ci.yml.disabled .github/workflows/ci.yml
# Every check lives in scripts/ci/ (each job calls scripts/ci/t3.sh --job <name>);
# keep this file in step with those scripts and lint it with actionlint.
name: CI

on:
  pull_request:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

defaults:
  run:
    shell: bash

jobs:
  contract:
    name: Contract and workflow lint
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24.14.1
      - name: Enable pnpm
        run: corepack enable pnpm && corepack install --global pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319
      - name: Install the frontend (Redocly and openapi-typescript are pinned by its lockfile)
        run: pnpm -C frontend install --frozen-lockfile
      - name: Install pinned tools
        run: scripts/ci/install-tools.sh actionlint shellcheck
      - name: Contract job
        run: scripts/ci/t3.sh --job contract
