# nginx edge of the calculator (RF-OPS-04). Rendered at container start into
# /etc/nginx/conf.d (inside the http block); NGINX_ENVSUBST_FILTER limits the
# substitution to the upstream address, every other $variable is nginx's.

# Correlation id (RF-API-07): an inbound X-Request-ID matching the contract
# pattern is kept, anything else (several headers arrive joined by ", ") is
# replaced by nginx's 32-hex $request_id. Header values cannot contain CR or LF,
# so this accepts exactly the contract's set.
map $http_x_request_id $correlation_id {
    default                     $request_id;
    "~^[A-Za-z0-9._-]{1,128}$"  $http_x_request_id;
}

# Host sent to the service: the client's value, port included; HTTP/1.0 clients
# may send none, and the service requires one.
map $http_host $upstream_host {
    default  $http_host;
    ""       localhost;
}

# Per client address and per nginx instance; API locations only.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
# Concurrent API requests per client address, counted only at the outer hop.
limit_conn_zone $binary_remote_addr zone=apiconn:10m;

server_tokens off;

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/css text/plain text/javascript application/javascript application/json
           application/problem+json application/yaml image/svg+xml;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/calculator;

    # Transport limit; the service enforces its own 4096-byte body limit.
    client_max_body_size 1m;
    # A client that stops sending is dropped instead of holding a buffer.
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;

    # For responses nginx produces before choosing a location (unsupported
    # method, oversized header or URI, malformed framing). Every location below
    # that adds its own headers includes the snippet again.
    include /etc/nginx/snippets/security-headers.conf;

    location = / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    # index.html, /theme-init.js, the favicon and other static files: revalidated
    # on every use. No HTML fallback: a missing file is a 404.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Content-hashed build output, source maps included: cached for a year.
    # Without `always`, a 404 is never cached.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;

        location ~ \.map$ {
            types { }
            default_type application/json;
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }
    }

    location = /nginx-health {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        types { }
        default_type text/plain;
        return 200 "ok\n";
    }

    # API, outer hop: request-rate, connection and transport limits, answered
    # with edge problems. No proxy_intercept_errors here: nginx intercepts every upstream
    # status that has an error_page in the proxying location, which would replace
    # the service's own 413. Upstream failures are converted by the inner hop.
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        limit_conn apiconn 20;
        limit_conn_status 429;
        limit_conn_log_level warn;
        error_page 413 = @payload_too_large;
        error_page 429 = @rate_limited;
        # Only nginx-generated: the inner hop unreachable or timed out.
        error_page 502 504 = @service_unavailable;
        include /etc/nginx/snippets/security-headers.conf;

        proxy_http_version 1.1;
        proxy_set_header Connection "close";
        proxy_set_header Host $upstream_host;
        # The inner hop must see the same validated id, or it would generate another.
        proxy_set_header X-Request-ID $correlation_id;
        proxy_connect_timeout 2s;
        # Longer than the inner hop's, so the inner hop always answers first.
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        proxy_next_upstream off;
        proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
        # The path nginx routed (normalised), not the raw request target: the
        # service must never see a path that nginx matched to another location.
        proxy_pass http://127.0.0.1:8079/api/;
    }

    # Without this, nginx answers /api with a redirect to /api/ that names the
    # container's internal port.
    location = /api {
        return 404;
    }

    # Probes go straight to the service, unlimited and uninterpreted: a draining
    # readiness 503 passes through. Only an unreachable service becomes a problem.
    # The routed path is forwarded, so an encoded path that nginx resolves to a
    # probe reaches the service as the probe.
    location = /healthz {
        # Probes take no body; Content-Length <= 16 KiB fits nginx's in-memory body buffer.
        client_max_body_size 16k;
        error_page 413 = @payload_too_large;
        error_page 502 504 = @service_unavailable;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
        # Probes take no body: none is forwarded.
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_pass http://${API_UPSTREAM}/healthz;
    }

    location = /readyz {
        # Probes take no body; Content-Length <= 16 KiB fits nginx's in-memory body buffer.
        client_max_body_size 16k;
        error_page 413 = @payload_too_large;
        error_page 502 504 = @service_unavailable;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
        # Probes take no body: none is forwarded.
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_pass http://${API_UPSTREAM}/readyz;
    }

    # Edge problems (RF-API-05): constants plus the validated correlation id only.
    # `types { }` stops `return` from taking the MIME type from the URI extension.
    location @payload_too_large {
        types { }
        default_type application/problem+json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 413 '{"type":"urn:calculator:problem:payload-too-large","title":"Payload too large","status":413,"detail":"request body must not exceed 4096 bytes","code":"PAYLOAD_TOO_LARGE","requestId":"$correlation_id"}';
    }

    location @rate_limited {
        types { }
        default_type application/problem+json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 429 '{"type":"urn:calculator:problem:rate-limited","title":"Too many requests","status":429,"detail":"slow down and retry shortly","code":"RATE_LIMITED","requestId":"$correlation_id"}';
    }

    location @service_unavailable {
        types { }
        default_type application/problem+json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 503 '{"type":"urn:calculator:problem:service-unavailable","title":"Service unavailable","status":503,"detail":"the calculator service is temporarily unavailable","code":"SERVICE_UNAVAILABLE","requestId":"$correlation_id"}';
    }
}

# API, inner hop: loopback only, never exposed. It converts service failures
# (502/503/504 returned or generated) into the edge 503 problem and passes every
# other response through unchanged. The outer hop adds the headers.
server {
    listen 127.0.0.1:8079;
    server_name _;
    access_log off;
    client_max_body_size 1m;

    location / {
        # The outer hop has already read and bounded the body.
        proxy_request_buffering off;
        proxy_intercept_errors on;
        error_page 502 503 504 = @service_unavailable;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_pass http://${API_UPSTREAM};
    }

    location @service_unavailable {
        types { }
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        return 503 '{"type":"urn:calculator:problem:service-unavailable","title":"Service unavailable","status":503,"detail":"the calculator service is temporarily unavailable","code":"SERVICE_UNAVAILABLE","requestId":"$correlation_id"}';
    }
}
