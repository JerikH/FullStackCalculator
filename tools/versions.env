# Pinned standalone tools: one KEY=value per line, no spaces, no quotes.
# Sourced by scripts/ci/*.sh. scripts/ci/install-tools.sh installs the binaries
# into the repository bin/. The five binary tools are verified against the
# SHA-256 below, copied from the release's published checksums (shellcheck
# publishes none: its values equal the asset digests GitHub reports for the
# release); govulncheck is verified by the Go checksum database.
# Node, pnpm and JavaScript tools follow frontend/package.json; Go modules follow
# backend/go.mod.
#
# Updating a tool: change its version and all four SHA-256 values in one commit,
# run scripts/ci/install-tools.sh <tool>, then scripts/ci/t3.sh --job contract. Dependabot does
# not see these pins: this procedure is how they stay current. The Node version is
# the same kind of pin: frontend/.node-version must equal the Node tag of
# frontend/Dockerfile and of the root Dockerfile (checked by scripts/ci/check-workflow.py).

GOLANGCI_LINT_VERSION=2.15.0
GOLANGCI_LINT_SHA256_linux_amd64=9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea
GOLANGCI_LINT_SHA256_linux_arm64=b4d8f17068b35ee6060cc2f69a16fb48740d706fbba81661c318649c114a6998
