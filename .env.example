# Copy to .env (git-ignored) only to override defaults; all values are non-secret.
# Compose reads .env; export overrides in your shell for Make and development commands.
# WEB_PORT selects a free port when port 8080 is busy.
# COMPOSE_PROJECT_NAME=fullstackcalculator
# WEB_PORT=8080
# IMAGE_TAG=local
# IMAGE_TAG defaults to COMPOSE_PROJECT_NAME for worker projects when using Make.
# VERSION=dev
# COMMIT=unknown
# Make derives VERSION from git describe --tags --always --dirty (fallback: dev).
# Make derives COMMIT from git rev-parse HEAD (fallback: unknown).
# Make always derives E2E_BASE_URL from WEB_PORT; pass E2E_BASE_URL=... on the make command line to change it.
# FUZZTIME=30s
# Development backend and frontend overrides:
# CALC_HTTP_ADDR=:8081
# CALC_ADMIN_ADDR=:9091
# CALC_LOG_LEVEL=info
# CALC_LOG_FORMAT=json
# VITE_PORT=5173
# API_PROXY_TARGET=http://localhost:8081
